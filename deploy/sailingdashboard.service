[Unit]
Description=Sailing dashboard (NMEA 2000 -> tablet web UI)
After=network.target

[Service]
EnvironmentFile=-/etc/default/sailingdashboard
ExecStart=/opt/sailingdashboard/sailingdashboard --web /opt/sailingdashboard/web --tiles /opt/sailingdashboard/tiles --record /var/lib/sailingdashboard/recordings $DASH_ARGS
DynamicUser=yes
# Recordings of the bus live in /var/lib/sailingdashboard (kept across restarts and updates).
StateDirectory=sailingdashboard
SupplementaryGroups=dialout
AmbientCapabilities=CAP_NET_BIND_SERVICE
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
